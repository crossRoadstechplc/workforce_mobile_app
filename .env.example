# Required for local flutter run (loaded by tool/run.ps1 → --dart-define).
# Point these at workforce-backend — not the old SPX tracker database.
APP_ENV=development
API_BASE_URL=http://127.0.0.1:4000/api/v1
SOCKET_BASE_URL=http://127.0.0.1:4000
ENABLE_FIREBASE=false
TASK_TRACKER_URL=http://127.0.0.1:3001

# Android emulator: use 10.0.2.2 instead of 127.0.0.1
# API_BASE_URL=http://10.0.2.2:4000/api/v1
# SOCKET_BASE_URL=http://10.0.2.2:4000
# TASK_TRACKER_URL=http://10.0.2.2:3001

# Baked into the APK and compared with backend ANDROID_APP_VERSION.
APP_VERSION=1.0.0
